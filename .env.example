# Copy this file to `.env` (local) and add the same variables in Vercel →
# Project → Settings → Environment Variables (production).
# Never commit the real `.env`: it is git-ignored.

# ── MongoDB Atlas (free 512 MB) ──────────────────────────────────────────────
# mongodb.com/atlas → create a free cluster → create a user → "Connect" → copy the string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sahab-portfolio?retryWrites=true&w=majority

# ── NextAuth (dashboard login) ───────────────────────────────────────────────
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=run-openssl-rand-base64-32-here
# http://localhost:3000 locally, your live URL in production.
NEXTAUTH_URL=http://localhost:3000

# ── Fallback admin (used before any dashboard user exists; run POST /api/setup once) ──
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your-secure-password
ADMIN_NAME=Sahab

# ── Resend email (free 3,000/month) — resend.com ─────────────────────────────
# Add your domain (or use onboarding@resend.dev for testing) → create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com
# Where quote/contact notifications are sent.
RESEND_TO=you@example.com

# ── Cloudinary images (free 25 GB) — cloudinary.com ──────────────────────────
# Dashboard → copy Cloud name, API Key and API Secret.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Public site ──────────────────────────────────────────────────────────────
# Live address, no trailing slash. Used for canonical URLs, sitemap and PageSpeed.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME="Your Name"

# ── Tracking tools on the website (optional) ─────────────────────────────────
# Leave empty = no tracking and no cookie banner. Set any of these and the
# consent banner appears; each tool loads only after the visitor accepts.
# Google Analytics 4 → Admin → Data streams → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_ID=
# Meta Events Manager → Data sources → Pixel ID (numbers only)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads → Tools → Conversions → Tag setup → Conversion ID (AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# LinkedIn Campaign Manager → Analyze → Insight Tag → Partner ID (numbers only)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# ── Dashboard → Analytics (server-only, never NEXT_PUBLIC) ───────────────────
# 1. Google Cloud → IAM → Service accounts → create one → Keys → Add key (JSON).
# 2. Enable "Google Analytics Data API" and "Google Search Console API".
# 3. GA4 → Admin → Property access management → add the service account email as Viewer.
# 4. Search Console → Settings → Users and permissions → add the same email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The JSON key's "private_key" on ONE line, wrapped in double quotes, keeping the \n sequences:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GA4 → Admin → Property details → Property ID (numbers only, not the G- ID)
GA4_PROPERTY_ID=
# The property exactly as Search Console shows it: sc-domain:example.com or https://example.com/
SEARCH_CONSOLE_SITE_URL=
# Optional: a Google Cloud API key raises the PageSpeed Insights quota.
PAGESPEED_API_KEY=
# Optional: page to test; defaults to NEXT_PUBLIC_SITE_URL.
PAGESPEED_URL=
