# ── MongoDB Atlas (free 512MB) ──────────────────────────────────────────────
# 1. Go to mongodb.com/atlas → Create free cluster
# 2. Create user → Get connection string → paste below
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/sahab-portfolio?retryWrites=true&w=majority

# ── NextAuth ────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
AUTH_SECRET=your-super-secret-key-at-least-32-characters-long
NEXTAUTH_URL=http://localhost:3000

# ── Dashboard Admin Credentials ─────────────────────────────────────────────
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your-secure-password-here

# ── Resend Email (free 3000/month) ──────────────────────────────────────────
# 1. Go to resend.com → Create account → Add domain (or use onboarding@resend.dev for testing)
# 2. Create API key → paste below
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com
RESEND_TO=frshahab.me@gmail.com

# ── Public ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME="your name"

# Cloudinary
CLOUDINARY_CLOUD_NAME=cloudeinary-cloud-name
CLOUDINARY_API_KEY=cloudeinary-api-key
CLOUDINARY_API_SECRET=cloudeinary-api-secret# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sahab-portfolio

# ── NextAuth ──────────────────────────────────────────────────────────────────
AUTH_SECRET=run-openssl-rand-base64-32-here
NEXTAUTH_URL=https://shahabweb.vercel.app

# ── Fallback admin (remove after running /api/setup) ─────────────────────────
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your-secure-password
ADMIN_NAME=Sahab

# ── Resend (free 3000/month) — resend.com ─────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com
RESEND_TO=frshahab.me@gmail.com

# ── Cloudinary (free 25GB) — cloudinary.com ───────────────────────────────────
# 1. Create free account at cloudinary.com
# 2. Dashboard → copy Cloud name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
